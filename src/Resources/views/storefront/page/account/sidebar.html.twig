{% sw_extends '@Storefront/storefront/page/account/sidebar.html.twig' %}

{% block page_account_sidebar_link_orders %}
    {{ parent() }}

    {% if config('Bonus.config.active') %}
        {% set bpRoute = 'frontend.account.bonus.page' %}
        <a href="{{ path(bpRoute) }}"
           title="Meine Punkte"
           class="list-group-item list-group-item-action account-aside-item{% if activeRoute is same as(bpRoute) %} is-active{% endif %}"
           {% if activeRoute is same as(bpRoute) %} aria-current="page"{% endif %}>
            Meine Punkte
        </a>
    {% endif %}
{% endblock %}

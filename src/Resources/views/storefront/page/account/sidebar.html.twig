{% sw_extends '@Storefront/storefront/page/account/sidebar.html.twig' %}

{% block page_account_sidebar_link_orders %}
    {{ parent() }}

    {% if config('MaxxpetBonus.config.active') %}
        {% set mxbRoute = 'frontend.account.maxxpet.bonus.page' %}
        <a href="{{ path(mxbRoute) }}"
           title="Meine Punkte"
           class="list-group-item list-group-item-action account-aside-item{% if activeRoute is same as(mxbRoute) %} is-active{% endif %}"
           {% if activeRoute is same as(mxbRoute) %} aria-current="page"{% endif %}>
            Meine Punkte
        </a>
    {% endif %}
{% endblock %}

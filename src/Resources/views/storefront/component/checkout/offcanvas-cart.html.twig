    {% set bp = page.getExtension('bonus') %}
    {% if bp %}
        {% sw_include '@Bonus/storefront/component/bonus/box.html.twig' with { bpMode: 'offcanvas', bpRedirect: 'frontend.checkout.cart.page' } %}
    {% endif %}
{% endblock %}

{#
  Punkte-Box für Warenkorb, Kasse und Off-Canvas.
  Erwartet: mxb (Seiten-Erweiterung maxxpetBonus), mxbMode ('cart' | 'confirm' | 'offcanvas'), mxbRedirect (Routenname).
#}
{% set cur = mxb.get('currency')|default('EUR') %}
<div class="checkout-aside-action mxbc mxbc--{{ mxbMode }}">

    {% if not mxb.get('loggedIn') %}
        {% if mxb.get('earn') > 0 %}
            <div class="mxbc__head"><span class="mxbc__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg></span><span class="mxbc__title">Punkte sammeln</span></div>
            <p class="mxbc__text">Mit Kundenkonto sammelst du mit dieser Bestellung <span class="mxbc__pill">+{{ mxb.get('earn')|number_format(0, ',', '.') }} Punkte</span></p>
            <a class="mxbc__link" href="{{ path('frontend.account.login.page') }}">Jetzt anmelden oder Konto anlegen</a>
        {% endif %}

    {% elseif not mxb.get('participant') %}
        {% if mxb.get('canJoin') %}
            <div class="mxbc__head"><span class="mxbc__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg></span><span class="mxbc__title">Bonusprogramm</span></div>
            {% if mxbMode == 'confirm' %}
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="mxbc-join" name="maxxpetBonusJoin" value="1" form="confirmOrderForm">
                    <label class="form-check-label" for="mxbc-join">Ich möchte am Bonusprogramm teilnehmen und mit dieser Bestellung Punkte sammeln.</label>
                </div>
            {% else %}
                <form action="{{ path('frontend.maxxpet.bonus.join') }}" method="post">
                    <input type="hidden" name="redirectTo" value="{{ mxbRedirect }}">
                    <p class="mxbc__text">Nimm am Bonusprogramm teil und sammle Punkte für jede Bestellung.</p>
                    <button type="submit" class="btn btn-primary">Am Bonusprogramm teilnehmen</button>
                </form>
            {% endif %}
        {% endif %}

    {% else %}
        <div class="mxbc__head">
            <span class="mxbc__icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.3 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg></span>
            <span class="mxbc__title">Meine Punkte</span>
            {% if mxb.get('levelsOn') and mxbMode != 'offcanvas' %}<span class="mxbc__lvl">{{ mxb.get('level') }}</span>{% endif %}
        </div>

        {% if mxb.get('redeemed') > 0 %}
            <div class="mxbc__balance">
                <span class="mxbc__big">−{{ mxb.get('redeemedAmount')|currency }}</span>
                <span class="mxbc__sub">{{ mxb.get('redeemed')|number_format(0, ',', '.') }} Punkte eingelöst</span>
            </div>
        {% else %}
            <div class="mxbc__balance">
                <span class="mxbc__big">{{ mxb.get('available')|number_format(0, ',', '.') }}<span class="mxbc__unit"> Punkte</span></span>
                <span class="mxbc__sub">{% if mxb.get('available') > 0 %}{{ mxb.get('availableValue')|currency }} Guthaben{% else %}noch kein Guthaben{% endif %}</span>
            </div>
        {% endif %}

        {% if mxbMode == 'offcanvas' %}
            {% if mxb.get('canRedeem') and mxb.get('redeemed') == 0 %}
                <form action="{{ path('frontend.maxxpet.bonus.redeem') }}" method="post">
                    <input type="hidden" name="redirectTo" value="frontend.checkout.cart.page">
                    <input type="hidden" name="points" value="{{ mxb.get('max') }}">
                    <button type="submit" name="action" value="redeem" class="btn btn-outline-primary btn-sm mxbc__btn">{{ mxb.get('max')|number_format(0, ',', '.') }} Punkte einlösen</button>
                </form>
            {% endif %}
        {% else %}
            {% if mxb.get('belowMinOrder') and mxb.get('available') >= mxb.get('min') %}
                <p class="mxbc__hint">Punkte kannst du ab einem Warenwert von {{ mxb.get('minOrderValue')|currency }} einlösen. Dir fehlen noch <strong>{{ mxb.get('missingToMinOrder')|currency }}</strong>.</p>
            {% elseif mxb.get('canRedeem') or mxb.get('redeemed') > 0 %}
                {% set startVal = mxb.get('redeemed') > 0 ? mxb.get('redeemed') : mxb.get('max') %}
                <form class="mxbc__form" action="{{ path('frontend.maxxpet.bonus.redeem') }}" method="post"
                      data-unit="{{ mxb.get('unit') }}" data-cur="{{ cur }}">
                    <input type="hidden" name="redirectTo" value="{{ mxbRedirect }}">
                    <label class="mxbc__label" for="mxbc-points-{{ mxbMode }}">Wie viele Punkte möchtest du einlösen?</label>
                    <div class="mxbc__row">
                        <input type="number" class="form-control mxbc__num" id="mxbc-points-{{ mxbMode }}" name="points" inputmode="numeric"
                               min="{{ mxb.get('min') }}" max="{{ mxb.get('max') }}" step="1" value="{{ startVal }}">
                        <span class="mxbc__eur" aria-live="polite"></span>
                    </div>
                    <input type="range" class="mxbc__range" aria-label="Punkte einlösen"
                           min="{{ mxb.get('min') }}" max="{{ mxb.get('max') }}" step="1" value="{{ startVal }}">
                    <div class="mxbc__btns">
                        <button type="submit" name="action" value="redeem" class="btn btn-primary">{{ mxb.get('redeemed') > 0 ? 'Ändern' : 'Punkte einlösen' }}</button>
                        {% if mxb.get('redeemed') > 0 %}
                            <button type="submit" name="action" value="remove" class="btn btn-link">Entfernen</button>
                        {% endif %}
                    </div>
                </form>
            {% elseif mxb.get('available') > 0 %}
                <p class="mxbc__hint">Einlösen ist ab {{ mxb.get('min')|number_format(0, ',', '.') }} Punkten möglich.</p>
            {% endif %}

            {% if mxb.get('levelsOn') and mxb.get('levelDiscountPct') > 0 %}
                <p class="mxbc__hint">Dein Treuerabatt als Level {{ mxb.get('level') }}: <strong>{{ mxb.get('levelDiscountPct')|number_format(1, ',', '.')|trim('0', 'right')|trim(',', 'right') }} %</strong>.
                    {% if not mxb.get('combine') %}Mit eingelösten Punkten entfällt der Treuerabatt, du kannst dich für eines von beiden entscheiden.{% endif %}</p>
            {% endif %}

            {% if mxb.get('giftChoices')|length %}
                <form class="mxbc__gift" action="{{ path('frontend.maxxpet.bonus.gift') }}" method="post">
                    <input type="hidden" name="redirectTo" value="{{ mxbRedirect }}">
                    <p class="mxbc__label">Dein Gratisprodukt zur Auswahl:</p>
                    {% for g in mxb.get('giftChoices') %}
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="sku" id="mxbc-gift-{{ mxbMode }}-{{ loop.index }}" value="{{ g.sku }}"{% if g.sku == mxb.get('giftSelected') %} checked{% endif %}>
                            <label class="form-check-label" for="mxbc-gift-{{ mxbMode }}-{{ loop.index }}">{{ g.label }}</label>
                        </div>
                    {% endfor %}
                    <div class="mxbc__btns">
                        <button type="submit" name="action" value="choose" class="btn btn-outline-primary btn-sm">Auswählen</button>
                        {% if mxb.get('giftSelected') %}<button type="submit" name="action" value="remove" class="btn btn-link btn-sm">Entfernen</button>{% endif %}
                    </div>
                </form>
            {% endif %}

            {% if mxb.get('giftNext') %}
                <p class="mxbc__hint">Noch <strong>{{ mxb.get('giftNext').missing|currency }}</strong> bis zum Gratisprodukt „{{ mxb.get('giftNext').label }}“.</p>
            {% endif %}

            {% if mxb.get('levelsOn') and mxb.get('levelNext') %}
                <div class="mxbc__progress">
                    <div class="mxbc__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ mxb.get('levelProgress') }}" aria-label="Fortschritt zum nächsten Level"><span style="width: {{ mxb.get('levelProgress') }}%"></span></div>
                    <small>Noch {{ mxb.get('levelMissing')|number_format(0, ',', '.') }} Punkte bis Level {{ mxb.get('levelNext') }}</small>
                </div>
            {% endif %}
        {% endif %}

        {% if mxb.get('earn') > 0 %}
            <p class="mxbc__earn">Mit dieser Bestellung sammelst du <span class="mxbc__pill">+{{ mxb.get('earn')|number_format(0, ',', '.') }} Punkte</span></p>
        {% endif %}
    {% endif %}
</div>

<style>
    .mxbc{margin:0 0 14px;padding:14px 16px;border:1px solid #d9e2ee;border-radius:14px;background:#f4f8fd;color:#173b59;box-shadow:0 1px 2px rgba(23,59,89,.05)}
    .mxbc__head{display:flex;align-items:center;gap:8px;margin-bottom:8px}
    .mxbc__icon{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:50%;background:#27832a;color:#fff;flex:none}
    .mxbc__title{font-weight:800;color:#043477;font-size:1.05rem}
    .mxbc__lvl{margin-left:auto;padding:2px 10px;border-radius:999px;background:#e3f4e4;color:#1b6b1f;font-size:.8rem;font-weight:800}
    .mxbc__balance{display:flex;flex-direction:column;margin:0 0 10px}
    .mxbc__big{font-size:1.9rem;line-height:1.1;font-weight:800;color:#043477}
    .mxbc__unit{font-size:1rem;font-weight:700;color:#4a6378}
    .mxbc__sub{font-size:.9rem;color:#4a6378}
    .mxbc__text,.mxbc__hint{margin:0 0 8px;font-size:.92rem}
    .mxbc__link{font-weight:700;color:#0649a8}
    .mxbc__pill{display:inline-block;padding:2px 10px;border-radius:999px;background:#e3f4e4;color:#1b6b1f;font-weight:800;white-space:nowrap}
    .mxbc__earn{margin:10px 0 0;padding-top:10px;border-top:1px solid #d9e2ee;font-size:.92rem}
    .mxbc__label{display:block;margin:8px 0 4px;font-size:.9rem;font-weight:700}
    .mxbc__row{display:flex;align-items:center;gap:10px}
    .mxbc__num{max-width:120px}
    .mxbc__eur{font-weight:800;color:#1f7a22}
    .mxbc__range{width:100%;min-height:28px;margin:10px 0 6px;accent-color:#27832a}
    .mxbc__btns{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
    .mxbc__gift{margin-top:10px;padding-top:8px;border-top:1px solid #d9e2ee}
    .mxbc__progress{margin-top:10px}
    .mxbc__progress small{display:block;margin-top:4px;color:#4a6378}
    .mxbc__bar{height:8px;overflow:hidden;border-radius:999px;background:#dbe6f3}
    .mxbc__bar span{display:block;height:100%;border-radius:999px;background:#27832a}
    .mxbc--offcanvas{margin:0 0 12px;padding:12px 14px}
    .mxbc--offcanvas .mxbc__big{font-size:1.5rem}
    .mxbc__btn{margin-top:2px}
</style>

{% if mxbMode != 'offcanvas' %}
    <script>
        (function () {
            document.querySelectorAll('.mxbc__form').forEach(function (f) {
                if (f.dataset.ready) return;
                f.dataset.ready = '1';
                var n = f.querySelector('.mxbc__num'), r = f.querySelector('.mxbc__range'), e = f.querySelector('.mxbc__eur');
                var unit = parseFloat(f.dataset.unit) || 0.03, min = parseInt(n.min, 10), max = parseInt(n.max, 10);
                function eur() {
                    var v = parseInt(n.value, 10) || 0;
                    try { e.textContent = '= ' + (v * unit).toLocaleString('de-DE', { style: 'currency', currency: f.dataset.cur || 'EUR' }); }
                    catch (x) { e.textContent = '= ' + (v * unit).toFixed(2) + ' €'; }
                }
                r.addEventListener('input', function () { n.value = r.value; eur(); });
                n.addEventListener('input', function () { var v = parseInt(n.value, 10); if (!isNaN(v)) { r.value = Math.max(min, Math.min(max, v)); } eur(); });
                n.addEventListener('change', function () { var v = parseInt(n.value, 10) || min; v = Math.max(min, Math.min(max, v)); n.value = v; r.value = v; eur(); });
                eur();
            });
        })();
    </script>
{% endif %}
